# Copy to .env.local (never commit it). Both are optional for local play.

# Where the game server lives. Empty = same host as the page, port 3001
# (works for phones on the same Wi-Fi that opened the page by its LAN address).
NEXT_PUBLIC_SERVER_URL=

# The public address phones should open (the lobby QR). Empty = this page's origin, or — when the
# host opened http://localhost — this machine's LAN address, asked from the server's /network.
NEXT_PUBLIC_PUBLIC_URL=
