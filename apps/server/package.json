{
  "name": "@khuuramch/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative game server for ХУУРАМЧ: NestJS 11 + Socket.IO.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "nest build && vitest run",
    "seed": "node dist/database/seed.js"
  },
  "dependencies": {
    "@khuuramch/content": "workspace:*",
    "@khuuramch/game-core": "workspace:*",
    "@khuuramch/protocol": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/websockets": "11.2.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.5",
    "socket.io-client": "4.8.4",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
