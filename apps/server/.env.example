# Copy to .env (never commit .env).

# HTTP + Socket.IO port. The web app expects 3001 unless NEXT_PUBLIC_SERVER_URL says otherwise.
PORT=3001
HOST=0.0.0.0

# Comma-separated web origins allowed to connect. Empty = allow any (development only).
CORS_ORIGINS=

# PostgreSQL for word packs + anonymous analytics. Empty = run without a database:
# word packs come from @khuuramch/content and analytics stay in memory.
# With docker compose: postgres://khuuramch:khuuramch@localhost:5432/khuuramch
DATABASE_URL=

# Secret for GET /admin/stats (header x-admin-secret). Empty = admin route disabled.
ADMIN_SECRET=

# Lets the web app ask for this machine's LAN address so the lobby QR works from phones.
# Defaults to on outside production.
EXPOSE_LAN=
