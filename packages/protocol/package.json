{
  "name": "@khuuramch/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Socket protocol for ХУУРАМЧ: event names, Zod schemas for both directions, error codes.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@khuuramch/game-core": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
